{
    "manifest_version": 3,
    "name": "LLM划词翻译",
    "description": "在网页划词后快速翻译，支持OpenAI及兼容大模型流式输出与设置页面",
    "version": "0.2.2",
    "permissions": ["storage", "activeTab", "contextMenus"],
    "host_permissions": [
        "https://api.openai.com/*",
        "https://openrouter.ai/*",
        "https://api.deepseek.com/*",
        "https://dashscope.aliyuncs.com/*",
        "https://open.bigmodel.cn/*",
        "https://api.xiaomimimo.com/*",
        "https://api.x.ai/*",
        "https://integrate.api.nvidia.com/*",
        "https://api.anthropic.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://translate.googleapis.com/*",
        "https://api-free.deepl.com/*",
        "https://api.deepl.com/*",
        "https://www.bing.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],
    "optional_host_permissions": ["https://*/*", "http://*/*", "file://*/*"],
    "action": {
        "default_title": "LLM划词翻译",
        "default_popup": "options.html"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "background/index.js",
        "type": "module"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "simple-translator@linji.dev",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["websiteContent"]
            }
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": [
                "libs/shared-config.js",
                "content/modules/state.js",
                "content/modules/utils.js",
                "content/modules/runtime.js",
                "content/modules/settings.js",
                "content/modules/lang-detect.js",
                "content/modules/browser-translate.js",
                "content/modules/pdf-prompt.js",
                "content/modules/ui.js",
                "content/modules/translate-port.js",
                "content/modules/translate-orchestrator.js",
                "content/modules/bootstrap.js",
                "content_script.js"
            ],
            "css": ["styles.css"],
            "run_at": "document_idle",
            "all_frames": true,
            "match_about_blank": true
        }
    ]
}
